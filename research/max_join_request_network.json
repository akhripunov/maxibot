{
  "capture": "sanitized",
  "transport": "WebSocket",
  "endpoint": "wss://api.oneme.ru/websocket",
  "operation": "JOIN_REQUEST",
  "request": {
    "chatId": "[REDACTED_CHANNEL_ID]",
    "count": 50
  },
  "response": {
    "top_level_fields": ["members"],
    "member_fields_observed": ["contact"],
    "contact_fields_observed": [
      "id",
      "updateTime",
      "registration",
      "baseUrl",
      "baseRawUrl",
      "photoId",
      "names",
      "type",
      "options",
      "accountStatus",
      "presence"
    ],
    "name_fields_observed": ["name", "firstName"],
    "presence_fields_observed": ["seen", "status"],
    "request_user": {
      "display_name": "Алёна Свинцова",
      "contact.id": "[MAX_USER_ID_REDACTED]"
    },
    "source_fields_found": [],
    "invite_fields_found": [],
    "request_id_fields_found": []
  },
  "actions_performed": [
    "opened pending join request list",
    "read WebSocket request/response frames"
  ],
  "actions_not_performed": ["approve", "reject", "regenerate invite", "change channel settings"]
}
