[Unit]
Description=MAXIBOT fail-closed Docker maintenance
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/maxibot
# The repository is deployed at /opt/maxibot; keep the executable path
# canonical and explicit.  The timer remains disabled until owner approval.
ExecStart=/opt/maxibot/scripts/docker_safe_maintenance_vps.sh --dry-run
