FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY docker/max-certs/*.crt /usr/local/share/ca-certificates/
RUN update-ca-certificates

# Install runtime/test dependencies directly.  The repository intentionally
# has several top-level non-package directories, so the production image's
# `pip install .[test]` packaging step is not suitable for this isolated QA
# image.
RUN pip install --no-cache-dir \
    "fastapi>=0.115" "uvicorn[standard]>=0.34" "sqlalchemy>=2.0" \
    "asyncpg>=0.30" "alembic>=1.14" "psycopg2-binary>=2.9" \
    "redis>=5.2" "pydantic-settings>=2.7" "jinja2>=3.1" \
    "httpx>=0.28" "cryptography>=43" "pytest>=8.3" \
    "pytest-asyncio>=0.25" "aiosqlite>=0.20" "Pillow>=10"

COPY . .
